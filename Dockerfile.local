FROM php:8.4-apache

RUN apt-get update && apt-get install -y \
    libpq-dev libzip-dev libicu-dev libonig-dev \
    libpng-dev libjpeg-dev libwebp-dev libfreetype6-dev \
    zip unzip git curl \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install pdo_pgsql pgsql zip mbstring intl opcache pcntl bcmath exif gd \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && a2enmod rewrite \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Replace default vhost with our wildcard config (supports *.localhost for multi-tenancy)
COPY deployment/config/apache-local.conf /etc/apache2/sites-available/000-default.conf

WORKDIR /var/www/html

EXPOSE 80

CMD ["apache2-foreground"]
